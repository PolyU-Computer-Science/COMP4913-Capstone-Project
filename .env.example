# Agentic Email Assistant
# Copy this file to .env, then select exactly one provider.
# Only the selected provider's MODEL, BASE_URL, and API_KEY are validated.

# local | openai | openrouter | anthropic | groq | deepseek | google
LLM_PROVIDER=local
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=120
LLM_MAX_TOKENS=2000

# OpenAI-compatible local server (LM Studio, vLLM, llama.cpp, or Ollama)
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL=local-model
# LOCAL_API_KEY=sk-...

# OpenAI
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...

# OpenRouter
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_API_KEY=sk-or-v1-...

# Anthropic
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# ANTHROPIC_API_KEY=sk-ant-...

# Groq
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_API_KEY=gsk_...

# DeepSeek
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_API_KEY=sk-...

# Google Gemini
GOOGLE_MODEL=gemini-2.0-flash
# GOOGLE_API_KEY=...

# ollama | openai | openrouter | mistral | gemini | hashing
EMBEDDING_PROVIDER=ollama
# Base URL for OpenAI-compatible endpoints (ollama: http://localhost:11434/v1)
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_MODEL=qwen3-embedding-4b
# API key resolved from the provider's official env var:
#   openrouter -> OPENROUTER_API_KEY, openai -> OPENAI_API_KEY,
#   mistral -> MISTRAL_API_KEY, gemini -> GEMINI_API_KEY
# Batch size for chunk embedding requests.
EMBEDDING_BATCH_SIZE=32

# Email IMAP settings
EMAIL_ENABLED=false
EMAIL_SERVER=imap.gmail.com
EMAIL_PORT=993
EMAIL_ADDRESS=
EMAIL_PASSWORD=
EMAIL_FOLDER=INBOX
EMAIL_MAX_EMAILS=50

# Backend API server
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated list of allowed frontend origins (for CORS)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Settings persistence
SQLITE_SETTINGS_DB=data/settings.db
# Optional: Fernet key for encrypting API keys/passwords. If unset, a key is
# auto-generated and persisted to data/.secret_key
# SETTINGS_ENCRYPTION_KEY=
