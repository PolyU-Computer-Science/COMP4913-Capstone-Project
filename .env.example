# Agentic Email Assistant
# Copy this file to .env, then select exactly one provider.
# Only the selected provider's MODEL, BASE_URL, and API_KEY are validated.

# local | openai | openrouter | anthropic | groq | deepseek | google
# Default happy path: OpenRouter (matches the evaluation configuration in
# the README). Swap LLM_PROVIDER to use a different provider below.
LLM_PROVIDER=openrouter
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=120
LLM_MAX_TOKENS=2000

# OpenAI-compatible local server (LM Studio, vLLM, llama.cpp, or Ollama)
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL=local-model
# LOCAL_API_KEY=sk-...

# OpenAI
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...

# OpenRouter (default)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=xiaomi/mimo-v2.5-pro
# OPENROUTER_API_KEY=sk-or-v1-...

# Anthropic
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# ANTHROPIC_API_KEY=sk-ant-...

# Groq
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_API_KEY=gsk_...

# DeepSeek
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_API_KEY=sk-...

# Google Gemini
GOOGLE_MODEL=gemini-2.0-flash
# GOOGLE_API_KEY=...

# ollama | openai | openrouter | mistral | gemini | hashing
# Default happy path: OpenRouter (matches the README evaluation setup).
EMBEDDING_PROVIDER=openrouter
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=qwen/qwen3-embedding-8b
# API key resolved from the provider's official env var:
#   openrouter -> OPENROUTER_API_KEY, openai -> OPENAI_API_KEY,
#   mistral -> MISTRAL_API_KEY, gemini -> GEMINI_API_KEY
# Batch size for chunk embedding requests.
EMBEDDING_BATCH_SIZE=32

# Email IMAP settings
EMAIL_ENABLED=false
EMAIL_SERVER=imap.gmail.com
EMAIL_PORT=993
EMAIL_ADDRESS=
EMAIL_PASSWORD=
EMAIL_FOLDER=INBOX
EMAIL_MAX_EMAILS=50

# Backend API server (keep 127.0.0.1 — the API is an unauthenticated local
# single-user prototype and must not be exposed to the network)
API_HOST=127.0.0.1
API_PORT=8000
# Comma-separated list of allowed frontend origins (for CORS)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Settings persistence
SQLITE_SETTINGS_DB=data/settings.db
# Optional: Fernet key for encrypting API keys/passwords. If unset, a key is
# auto-generated and persisted to data/.secret_key
# SETTINGS_ENCRYPTION_KEY=

# MCP SSRF guard: comma-separated https URLs allowed to bypass the
# public-host check (loopback/private IPs are rejected otherwise).
# ALLOWED_MCP_SERVERS=https://demo.solutionforest.net/mcp/mtr/
